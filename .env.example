# ============================================================
#  Plane Community Edition — Environment Variables
#  Copy this file to .env and fill in all secrets before
#  running the stack for the first time.
#
#  IMPORTANT: Never commit .env to version control.
# ============================================================


# ------------------------------------------------------------
# Compose project name  ← CHANGE THIS PER INSTANCE
#
# Used as a prefix for all container names, volumes, and
# networks so that multiple instances can coexist on the same
# Docker host without naming collisions.
#
# Rules:
#  • Must be unique across every Plane deployment on the host.
#  • Use lowercase letters, digits, and hyphens only.
#  • Changing it after first run renames containers but leaves
#    old volumes orphaned — migrate data before renaming.
#
# Examples:
#   plane-prod      → production instance
#   plane-staging   → staging instance
#   plane-team-abc  → second tenant on the same server
# ------------------------------------------------------------
COMPOSE_PROJECT_NAME=plane-prod


# ------------------------------------------------------------
# Plane release / image settings
#
# APP_RELEASE  — Docker image tag pulled from Docker Hub.
#                Pin to a specific release tag (e.g. "v1.4.1"),
#                or use "stable" to always follow the latest
#                stable release.
#                This repository supports stepwise migration
#                between releases — see docs/MIGRATION.md and
#                run `./setup.sh upgrade` to move forward one
#                release at a time with a backup before each.
# DOCKERHUB_USER — Registry prefix (change only if mirroring).
# PULL_POLICY  — Docker Compose image pull policy.
#                Options: always | if_not_present | never
# ------------------------------------------------------------
APP_RELEASE=v1.2.3
DOCKERHUB_USER=makeplane
PULL_POLICY=if_not_present


# ------------------------------------------------------------
# General / networking
#
# DOMAIN_NAME  — Publicly accessible hostname of this instance
#                (without protocol or trailing slash).
# WEB_URL      — Full base URL including protocol, used for
#                internal link generation and CORS.
# CORS_ALLOWED_ORIGINS — Comma-separated list of origins
#                allowed to make cross-origin API requests.
# DEBUG        — Set to 1 only in development environments.
# LISTEN_HTTP_PORT — Port that plane-proxy binds on the host.
#                nginx on the Debian 12 host will proxy to
#                this port.  Choose any free port (e.g. 8080).
# ------------------------------------------------------------
DOMAIN_NAME=plane.example.com
WEB_URL=https://plane.example.com
CORS_ALLOWED_ORIGINS=https://plane.example.com
DEBUG=0
LISTEN_HTTP_PORT=8080


# ------------------------------------------------------------
# Secrets — REQUIRED, must be changed from defaults
#
# SECRET_KEY   — Django secret key.  Generate with:
#                python3 -c "import secrets; print(secrets.token_hex(50))"
# LIVE_SERVER_SECRET_KEY — Secret shared by the backend and the live
#                WebSocket server.  Must be identical across api,
#                worker, beat-worker, migrator and live.
# ------------------------------------------------------------
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING
LIVE_SERVER_SECRET_KEY=CHANGE_ME_LIVE_SERVER_SECRET_KEY


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
POSTGRES_HOST=plane-db
POSTGRES_USER=plane
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=plane
POSTGRES_PORT=5432
# Full connection string (takes precedence over individual vars if set):
# DATABASE_URL=postgresql://plane:CHANGE_ME_DB_PASSWORD@plane-db:5432/plane


# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_HOST=plane-redis
REDIS_PORT=6379
# Full connection string (takes precedence if set):
# REDIS_URL=redis://plane-redis:6379/


# ------------------------------------------------------------
# RabbitMQ  (task queue for Celery workers)
# ------------------------------------------------------------
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=plane
RABBITMQ_DEFAULT_PASS=CHANGE_ME_MQ_PASSWORD
RABBITMQ_DEFAULT_VHOST=plane
# Full AMQP URL (takes precedence if set):
# AMQP_URL=amqp://plane:CHANGE_ME_MQ_PASSWORD@plane-mq:5672/plane


# ------------------------------------------------------------
# MinIO (S3-compatible object storage)
#
# AWS_* vars are used by the Django backend.
# MINIO_* vars configure the MinIO container itself.
# ------------------------------------------------------------
USE_MINIO=1
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_ENDPOINT_SSL=0

# These must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above:
AWS_ACCESS_KEY_ID=CHANGE_ME_MINIO_USER
AWS_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=uploads
# Endpoint the Django backend uses to reach MinIO internally:
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
BUCKET_NAME=uploads
# Maximum upload size in bytes (default: 5 MB):
FILE_SIZE_LIMIT=5242880


# ------------------------------------------------------------
# Gunicorn / scaling
#
# GUNICORN_WORKERS — Number of Gunicorn child processes.
#                    Use 2 × vCPUs + 1 as a starting point.
# *_REPLICAS       — Number of Docker Compose replicas for
#                    each service (requires Docker Swarm or
#                    Compose v2 deploy.replicas for true HA).
# ------------------------------------------------------------
GUNICORN_WORKERS=2
WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1


# ------------------------------------------------------------
# Resource limits (CPU / memory)
#
# Hard caps applied to each container via deploy.resources.limits.
# They prevent a runaway process (e.g. a spinning Node worker) from
# exhausting the whole host.  CPU is in cores (fractional allowed),
# memory accepts b/k/m/g.  See docs/SECURITY_AUDIT.md.
# ------------------------------------------------------------
MIGRATOR_CPU_LIMIT=1.0
MIGRATOR_MEM_LIMIT=1g
API_CPU_LIMIT=2.0
API_MEM_LIMIT=2g
WORKER_CPU_LIMIT=2.0
WORKER_MEM_LIMIT=2g
BEAT_WORKER_CPU_LIMIT=0.5
BEAT_WORKER_MEM_LIMIT=512m
WEB_CPU_LIMIT=1.0
WEB_MEM_LIMIT=512m
SPACE_CPU_LIMIT=1.0
SPACE_MEM_LIMIT=512m
ADMIN_CPU_LIMIT=1.0
ADMIN_MEM_LIMIT=512m
LIVE_CPU_LIMIT=1.0
LIVE_MEM_LIMIT=512m
PROXY_CPU_LIMIT=1.0
PROXY_MEM_LIMIT=256m
DB_CPU_LIMIT=2.0
DB_MEM_LIMIT=2g
REDIS_CPU_LIMIT=1.0
REDIS_MEM_LIMIT=512m
MQ_CPU_LIMIT=1.0
MQ_MEM_LIMIT=1g
MINIO_CPU_LIMIT=2.0
MINIO_MEM_LIMIT=1g


# ------------------------------------------------------------
# SMTP (optional — needed for email notifications)
# ------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
# EMAIL_USE_TLS and EMAIL_USE_SSL are mutually exclusive.
# Port 587 (STARTTLS): EMAIL_USE_TLS=1, EMAIL_USE_SSL=0
# Port 465 (SMTPS):    EMAIL_USE_TLS=0, EMAIL_USE_SSL=1
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_FROM=noreply@plane.example.com


# ------------------------------------------------------------
# GitHub OAuth (optional integration)
# ------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# ------------------------------------------------------------
# Slack OAuth (optional integration)
# ------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=


# ------------------------------------------------------------
# GitLab OAuth (optional integration)
# ------------------------------------------------------------
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=


# ------------------------------------------------------------
# Backup & migration
#
# BACKUP_DIR — Directory (relative to the repository root) where
#              `./setup.sh backup` stores timestamped backups.
#              Each backup contains a PostgreSQL dump and the
#              MinIO file volume, plus a copy of `.env`.
# BACKUP_RETENTION_DAYS — Number of days to keep backups.
#              Backups older than this are pruned automatically
#              by `./setup.sh backup`.
# ------------------------------------------------------------
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
